# Firebase / Google
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# Ou, em alternativa ao arquivo:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Projeto (deve bater com o frontend)
FIREBASE_PROJECT_ID=ari-b0f40

# CORS — origem do Vite em desenvolvimento
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Limite de itens por fonte por execução
COLLECT_MAX_ITEMS_PER_SOURCE=30

# OpenAI — opcional nesta sprint (sem chave = modo passthrough)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# auto | openai | passthrough
AI_MODE=auto
AI_MAX_BATCH=10

# Scheduler / Cloud Tasks — header X-Internal-Secret
INTERNAL_API_SECRET=change-me-in-production
