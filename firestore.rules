rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function isAdmin() {
      return userExists() && userData().role == 'admin';
    }

    function isAdminFull() {
      return isAdmin() && (
        userData().isPrincipal == true
        || userData().adminPermission == 'full'
      );
    }

    function isUser() {
      return userExists() && userData().role == 'user';
    }

    // ── Usuários ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if (isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'role', 'createdAt', 'name', 'birthDate', 'selectedState'])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.birthDate is string
        && request.resource.data.selectedState is string
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt == request.time)
        || (isAdminFull()
          && request.resource.data.role == 'admin'
          && request.resource.data.keys().hasAll(['email', 'role', 'createdAt', 'name', 'birthDate', 'selectedState', 'adminPermission', 'isPrincipal'])
          && request.resource.data.email is string
          && request.resource.data.name is string
          && request.resource.data.adminPermission in ['full', 'view']
          && request.resource.data.isPrincipal == false
          && request.resource.data.createdAt == request.time);

      allow update: if isAdminFull()
        || (isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminPermission', 'isPrincipal']))
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'birthDate', 'createdAt', 'adminPermission', 'isPrincipal']));

      allow delete: if isAdminFull();
    }

    match /sources/{docId} {
      allow read: if isAdmin() || isUser();

      allow create: if isAdminFull()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.siteUrl is string
        && request.resource.data.siteUrl.size() > 0
        && request.resource.data.kind in ['rss', 'website', 'api']
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.categoryIds is list
        && request.resource.data.newsCount is int
        && request.resource.data.newsCount == 0
        && request.resource.data.createdBy is string
        && request.resource.data.keys().hasAll([
          'name', 'siteUrl', 'kind', 'categoryIds', 'status',
          'newsCount', 'createdBy', 'createdAt', 'updatedAt'
        ]);

      allow update: if isAdminFull()
        && request.resource.data.name is string
        && request.resource.data.siteUrl is string
        && request.resource.data.kind in ['rss', 'website', 'api']
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.categoryIds is list
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['createdAt', 'createdBy']);

      allow delete: if isAdminFull();
    }

    match /categories/{docId} {
      allow read: if isAdmin() || isUser();

      allow create, update: if isAdminFull()
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.active is bool;

      allow delete: if isAdminFull();
    }

    match /collectedNews/{docId} {
      allow read: if isAdmin() || isUser();
      allow write: if false;
    }

    match /collectionRuns/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /articles/{docId} {
      allow read: if isAdmin() || isUser();
      allow write: if false;
    }

    match /reviews/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /publications/{docId} {
      allow read: if isAdmin() || isUser();
      allow write: if false;
    }

    match /aiJobs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /activityLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /editorialProfiles/{docId} {
      allow read: if isAdmin() || isUser();
      allow write: if isAdmin();
    }

    match /portalSettings/{docId} {
      allow read: if isAdmin() || isUser();
      allow write: if isAdmin();
    }
  }
}
